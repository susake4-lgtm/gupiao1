# 复制为 config/futures.env 后填写值

# Futures API 服务监听地址
FUTURES_API_HOST=127.0.0.1
FUTURES_API_PORT=8010

# Futures 数据落地目录（可选，默认 data/futures）
# FUTURES_DATA_DIR=data/futures

# 飞书机器人 Webhook（用于 scripts/run-futures-briefing-once.sh）
# FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx
