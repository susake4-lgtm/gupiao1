# 复制为 config/acp-bridge.env 后按需调整

# bridge 监听地址（只给本机 OpenClaw 用）
ACP_BRIDGE_HOST=127.0.0.1
ACP_BRIDGE_PORT=8001

# 仅允许本机访问
ACP_BRIDGE_ALLOWED_IPS=127.0.0.1
ACP_BRIDGE_TOKEN=change-me-local-token

# 会话与进程池
ACP_BRIDGE_SESSION_TTL_HOURS=24
ACP_BRIDGE_SHUTDOWN_TIMEOUT=30
ACP_BRIDGE_MAX_PROCESSES=4
ACP_BRIDGE_MAX_PER_AGENT=2

# Claude Code 固定工作目录
ACP_BRIDGE_WORKDIR=/Users/apple/xinxisouji/gupiao1
ACP_BRIDGE_AGENT=claude
ACP_BRIDGE_AGENT_MODE=pty

# 本机 Claude CLI：默认通过 wrapper 强制非交互执行
CLAUDE_CODE_COMMAND=/Users/apple/xinxisouji/gupiao1/scripts/claude-print-wrapper.sh
CLAUDE_CODE_REAL_COMMAND=/opt/homebrew/bin/claude
# start-acp-bridge.sh 会自动补上 -p；这里保留其它参数
CLAUDE_CODE_ARGS="--model sonnet --permission-mode acceptEdits"

# 运行时生成的 bridge 配置文件
ACP_BRIDGE_RUNTIME_CONFIG=/tmp/gupiao1-acp-bridge.config.yaml

# Volcengine Coding API（替代 modify/create 写入链路时使用）
CODING_WRITE_BACKEND=volcengine
VOLCENGINE_CODING_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
VOLCENGINE_CODING_MODEL=Doubao-Seed-2.0-pro
VOLCENGINE_CODING_API_KEY=
VOLCENGINE_CODING_WORKDIR=/Users/apple/xinxisouji/gupiao1
VOLCENGINE_CODING_TIMEOUT_SECONDS=600
VOLCENGINE_CODING_POLL_INTERVAL_SECONDS=3
VOLCENGINE_CODING_MAX_POLLS=200
ACP_BRIDGE_FALLBACK_ENABLED=true
