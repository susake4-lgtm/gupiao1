# 复制为 config/dsa.env 后填写真实值
# 该文件由 gupiao1 外层脚本加载，然后调用 external/daily_stock_analysis/main.py

# =====================
# 最小必填
# =====================
# 至少配置一个可用模型 Key
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# AIHUBMIX_KEY=

# 飞书机器人 Webhook
FEISHU_WEBHOOK_URL=

# 自选股列表。
# 如果你更想单独维护文件，也可以把这里留空，改用 config/stocks.md
STOCK_LIST=600519,300750,002594

# =====================
# 推荐保留的基础配置
# =====================
REPORT_TYPE=simple
MARKET_REVIEW_ENABLED=true
TRADING_DAY_CHECK_ENABLED=true
REALTIME_SOURCE_PRIORITY=tencent,akshare_sina,efinance,akshare_em

# 搜索能力（可选，但通常有助于提升分析质量）
TAVILY_API_KEYS=
SERPAPI_API_KEYS=
BOCHA_API_KEYS=

# 定时运行（供上游配置和脚本复用）
SCHEDULE_ENABLED=true
SCHEDULE_TIME=18:00
SCHEDULE_RUN_IMMEDIATELY=false

# 代理（如果本机访问模型或搜索服务需要）
USE_PROXY=false
PROXY_HOST=127.0.0.1
PROXY_PORT=10809

# 本地 API / OpenClaw 相关
DSA_API_HOST=127.0.0.1
DSA_API_PORT=8000
OPENCLAW_BIND=loopback
OPENCLAW_PORT=18789
OPENCLAW_CHAT_API_HOST=127.0.0.1
OPENCLAW_CHAT_API_PORT=18889
OPENCLAW_CHAT_API_TOKEN=
OPENCLAW_CHAT_API_TIMEOUT_SECONDS=120
OPENCLAW_CHAT_API_MODIFY_TIMEOUT_SECONDS=600
OPENCLAW_CHAT_API_URL=http://127.0.0.1:18889
FEISHU_OPENCLAW_HOST=127.0.0.1
FEISHU_OPENCLAW_PORT=18989
FEISHU_BASE_URL=https://open.feishu.cn
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_OPENCLAW_TIMEOUT_SECONDS=120
FEISHU_GROUP_REQUIRE_MENTION=true

# 可按需补充的其他上游变量：
# TUSHARE_TOKEN=
# SINGLE_STOCK_NOTIFY=false
# MARKET_REVIEW_REGION=cn
# MAX_WORKERS=1
