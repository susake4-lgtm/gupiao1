# 复制为 config/trendradar.env 后填写值

# TrendRadar 项目目录（默认 ../TrendRadar）
# TRENDRADAR_DIR=/Users/apple/xinxisouji/TrendRadar

# TrendRadar 配置文件（默认 $TRENDRADAR_DIR/config/config.yaml）
# CONFIG_PATH=/Users/apple/xinxisouji/TrendRadar/config/config.yaml

# 飞书机器人 Webhook（必填）
FEISHU_WEBHOOK_URL=

# run-trendradar-once.sh 会强制 SCHEDULE_ENABLED=false，确保单次运行
# SCHEDULE_ENABLED=false

# 最小闭环建议先关闭 AI 分析；如果要开启，再补齐 AI_MODEL / AI_API_KEY
# 若要标题自动翻译为中文，请在 TrendRadar 的 config.yaml 中开启 AI_TRANSLATION.ENABLED=true
AI_ANALYSIS_ENABLED=false

# 可选：时区覆盖
# TIMEZONE=Asia/Shanghai

# 定时模式也建议关闭自动打开本地 HTML 页面
TRENDRADAR_NO_BROWSER=true
